# Database Configuration
# Neon PostgreSQL connection string for Drizzle ORM
DATABASE_URL=postgresql://user:password@host/database

# Authentication
# JWT secret key for token signing (minimum 32 characters for production)
JWT_SECRET=your-secret-key-change-me-in-production-32chars!

# Admin Access
# Comma-separated list of usernames that have admin access
ADMIN_USERNAMES=admin,admin2

# EmailJS Configuration (Public - safe to expose)
# Get these from your EmailJS account at https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_xxxxxxxxxxxx

# Google Gemini AI Configuration
# Get your API key from https://console.cloud.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model Configuration (Optional)
# Model to use for AI responses (defaults to 'gemini-3.5-flash-lite')
GEMINI_MODEL=gemini-3.5-flash-lite

# Maximum tokens for Gemini responses (defaults to 500)
GEMINI_MAX_TOKENS=500

# Temperature for Gemini responses - controls randomness (0.0-2.0, defaults to 0.7)
GEMINI_TEMPERATURE=0.7
